<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<VBox stylesheets="@theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.bike.fx.profile.LoginController" fx:id="root" prefWidth="520" prefHeight="320" spacing="14" styleClass="dialog">
  <Label text="Вход в профиль" wrapText="true" styleClass="title" />
  <Label fx:id="name" />
  <Label text="Пароль" wrapText="true" />
  <PasswordField fx:id="password" onAction="#login" />
  <Button text="Войти" onAction="#login" fx:id="loginButton" styleClass="primary">
  </Button>
  <Label fx:id="status" wrapText="true" styleClass="status" />
</VBox>